# WASenderAPI Personal Access Token (paid plan). Get it from WASenderAPI settings.
WASENDER_PAT=

# Passphrase you type on the consent screen when connecting from Claude.ai.
# Use a long random value.
ADMIN_PASSPHRASE=

# Upstream MCP to wrap. Leave as-is unless WASenderAPI changes their endpoint.
UPSTREAM_MCP_URL=https://wasenderapi.com/mcp

# Public HTTPS origin of the proxy (the Cloudflare Quick Tunnel URL).
# Leave EMPTY here: scripts/up.sh discovers the trycloudflare.com URL and fills it in.
# Example: https://random-three-words.trycloudflare.com  (no trailing slash, no /mcp)
PUBLIC_BASE_URL=
